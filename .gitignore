# Raw bitstreams: large, regenerable, hashes anchored in data/MANIFEST.sha256.
data/*.bin
!data/golden/*.bin

# Derived analysis artifacts. Small summary CSVs are force-added on purpose
# (see below); the large per-block tables are regenerable and stay out.
data/*.csv
data/*.npy
data/*.npz
data/*_progress.log
data/*.progress.log

# Exceptions that ARE tracked. Keeping these explicit stops the repo from
# drifting back into "gitignore says one thing, git ls-files says another".
!data/block_frequency_summary.csv
!data/autocorrelation_top20.csv
!data/bit_distribution.csv
!data/markov_results.csv
!data/autocorrelation.npy
!data/MANIFEST.sha256

# block_freq_k1..k14 are tracked (1.3 MB total); k15..k20 are not (87 MB) and
# are regenerated by experiments/block_frequency.py.
!data/block_freq_k1.csv
!data/block_freq_k2.csv
!data/block_freq_k3.csv
!data/block_freq_k4.csv
!data/block_freq_k5.csv
!data/block_freq_k6.csv
!data/block_freq_k7.csv
!data/block_freq_k8.csv
!data/block_freq_k9.csv
!data/block_freq_k10.csv
!data/block_freq_k11.csv
!data/block_freq_k12.csv
!data/block_freq_k13.csv
!data/block_freq_k14.csv

__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# SAT toolchain built by tools/build_sat_toolchain.sh (rebuildable, not vendored).
third_party/

# Delegated-task artifacts (tools/codex_worker.py): prompt, raw reply, patch,
# verification log. Transient working material for one task -- the reviewable
# output is the codex/<task> branch, which git already keeps. Distinct from
# runs/<name>/, which workhorse.py commits because it IS the experiment record.
runs/codex/
runs/pool/

# The trap manifest's refusal record. tests/test_workhorse.py drives a real
# workhorse refusal to prove the counting-bound gate still bites, and
# workhorse writes the record into the real queue/refused/. The test unlinks
# it in a `finally`, but a run killed by a timeout never reaches that -- and
# codex_worker.changed_files() does `git add -A`, so a leftover would be
# staged, committed, and attributed to whichever delegated worker happened to
# time out. Real refusals (any other name) stay tracked, which is the point of
# the directory.
queue/refused/t-trap-*.json
